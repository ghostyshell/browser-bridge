#!/usr/bin/env node
// Entry point. The real CLI is compiled from src/cli/chromectl.ts.
// Keep this file tiny: it only locates the repo and hands over.
'use strict';

const path = require('node:path');
const fs = require('node:fs');

const root = path.resolve(__dirname, '..');
const built = path.join(root, 'dist', 'cli', 'chromectl.js');

if (!fs.existsSync(built)) {
  process.stderr.write('chromectl: not built yet - run `npm install && npm run build` in ' + root + '\n');
  process.exit(1);
}

process.env.BB_ROOT = root;
require(built);
