{
  "name": "browser-bridge",
  "version": "1.5.8",
  "private": true,
  "description": "Drive your real Chrome from any CLI agent: parked tab group, numbered snapshots, click/type/scroll/screenshot over localhost.",
  "license": "MIT",
  "author": "ghost",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "smoke": "bash scripts/smoke-test.sh",
    "start": "node dist/daemon/server.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
